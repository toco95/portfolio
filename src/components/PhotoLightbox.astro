  <!-- Lightbox -->
  <div id="lightbox">
    <button id="lb-prev" class="lb-arrow lb-arrow--left" aria-label="Previous photo">
      <svg width="24" height="24" viewBox="0 0 256 256" fill="currentColor"><path d="M168.49,199.51a12,12,0,0,1-17,17l-80-80a12,12,0,0,1,0-17l80-80a12,12,0,0,1,17,17L97,128Z"/></svg>
    </button>
    <img id="lightbox-img" alt="" />
    <button id="lb-next" class="lb-arrow lb-arrow--right" aria-label="Next photo">
      <svg width="24" height="24" viewBox="0 0 256 256" fill="currentColor"><path d="M184.49,136.49l-80,80a12,12,0,0,1-17-17L159,128,87.51,56.49a12,12,0,0,1,17-17l80,80A12,12,0,0,1,184.49,136.49Z"/></svg>
    </button>
  </div>

  <style>
    /* ─── Lightbox ─── */

    #lightbox {
      position: fixed;
      inset: 0;
      z-index: var(--layer-modal);
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgb(var(--color-overlay-dark-rgb) / 0.9);
      backdrop-filter: blur(8px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    #lightbox.active {
      opacity: 1;
      pointer-events: auto;
    }

    #lightbox-img {
      max-height: 95vh;
      max-width: calc(95vw - 120px);
      object-fit: contain;
      cursor: pointer;
    }

    .lb-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgb(var(--color-overlay-light-rgb) / 0.1);
      border: none;
      border-radius: 50%;
      padding: 8px;
      color: rgb(var(--color-overlay-light-rgb));
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .lb-arrow:hover {
      background: rgb(var(--color-overlay-light-rgb) / 0.2);
    }

    .lb-arrow--left { left: 16px; }
    .lb-arrow--right { right: 16px; }
  </style>

  <script>


    let lightboxController: AbortController | undefined;

    function initLightbox() {
      lightboxController?.abort();
      lightboxController = new AbortController();
      const { signal } = lightboxController;

      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const btnPrev = document.getElementById('lb-prev');
      const btnNext = document.getElementById('lb-next');
      if (!lightbox || !lightboxImg || !btnPrev || !btnNext) return;
      const lightboxEl = lightbox;
      const lightboxImageEl = lightboxImg;
      let photos: HTMLImageElement[] = [];
      let currentIndex = 0;

      function refreshPhotos() {
        photos = Array.from(document.querySelectorAll<HTMLImageElement>('.photo-album-detail.active [data-lightbox]'));
      }

      function show(index: number) {
        currentIndex = (index + photos.length) % photos.length;
        lightboxImageEl.src = photos[currentIndex].src;
        lightboxImageEl.alt = photos[currentIndex].alt;
      }

      function open(index: number) {
        refreshPhotos();
        show(index);
        lightboxEl.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function close() {
        lightboxEl.classList.remove('active');
        document.body.style.overflow = '';
      }

      // Delegate click on lightbox photos
      document.getElementById('photo-detail')?.addEventListener('click', (e) => {
        const img = (e.target as HTMLElement).closest('[data-lightbox]') as HTMLImageElement | null;
        if (!img) return;
        refreshPhotos();
        const index = photos.indexOf(img);
        if (index >= 0) open(index);
      }, { signal });

      btnPrev.addEventListener('click', (e) => { e.stopPropagation(); show(currentIndex - 1); }, { signal });
      btnNext.addEventListener('click', (e) => { e.stopPropagation(); show(currentIndex + 1); }, { signal });
      lightboxImageEl.addEventListener('click', (e) => { e.stopPropagation(); show(currentIndex + 1); }, { signal });
      lightboxEl.addEventListener('click', close, { signal });

      document.addEventListener('keydown', (e) => {
        if (!lightboxEl.classList.contains('active')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') { e.preventDefault(); show(currentIndex - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); show(currentIndex + 1); }
      }, { signal });

      document.addEventListener('astro:before-swap', () => {
        close();
        lightboxController?.abort();
        lightboxController = undefined;
      }, { once: true, signal });
    }

    function init() {

      initLightbox();
    }

    document.addEventListener('astro:page-load', init);
  </script>
