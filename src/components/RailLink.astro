---
interface Props { href: string; label: string; icon: string; active?: boolean; }
const { href, label, icon, active = false } = Astro.props;
---
<a class="rail-link" href={href} aria-current={active ? 'page' : undefined}>
  <span class="rail-icon" style={`mask-image: url(${icon})`} aria-hidden="true"></span>{label}
</a>
<style>
  .rail-link { display: flex; align-items: center; gap: var(--space-2); min-height: var(--space-8); padding: var(--space-1) var(--space-2); border-radius: var(--radius-md); color: var(--color-text-secondary); font-size: var(--text-base); font-weight: var(--font-weight-medium); line-height: 1.25; }
  .rail-link:hover, .rail-link[aria-current="page"] { background: var(--color-bg-active); color: var(--color-text-primary); }
  .rail-icon { width: 16px; height: 16px; flex-shrink: 0; background: currentColor; mask-size: contain; mask-repeat: no-repeat; mask-position: center; }
</style>
