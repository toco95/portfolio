---
import Icon from './Icon.astro';
import { links } from '../data/links';
const places = [
  { label: 'Cafés', icon: 'coffee', description: 'Coffee, pastries, and a little pause.', href: links.paris.cafes },
  { label: 'Restaurants', icon: 'fork-knife', description: 'Lunch spots and places to linger.', href: links.paris.restaurants },
  { label: 'Bars', icon: 'wine', description: 'Wine, cocktails, and a few tapas.', href: links.paris.bars },
];
---
<dialog id="paris-modal" aria-labelledby="paris-title" aria-describedby="paris-description">
  <div class="modal-header">
    <span class="eyebrow"><span class="map-badge" aria-hidden="true"></span>PARIS, FRANCE</span>
    <form method="dialog"><button aria-label="Close Paris spots" autofocus><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button></form>
  </div>
  <h2 id="paris-title">My Paris, saved.</h2>
  <p id="paris-description">I spend a lot of time looking for my next good bite. These are the cafés, restaurants, and bars I’ve saved along the way.</p>
  <nav aria-label="My Google Maps lists">
    {places.map(place => <a href={place.href} target="_blank" rel="noopener noreferrer">
      <span class="category-icon" style={`--category-icon: url('/images/icons/${place.icon}.svg')`} aria-hidden="true"></span>
      <span class="category-copy"><span class="category-title">{place.label}</span><span class="category-description">{place.description}</span></span>
      <Icon name="arrow-up-right" size={16} />
    </a>)}
  </nav>
  <p class="modal-footnote">Three lists, plenty of reasons to go out.</p>
</dialog>
<script>
  function initParisModal() {
    const dialog = document.querySelector<HTMLDialogElement>('#paris-modal');
    const triggers = document.querySelectorAll<HTMLButtonElement>('[data-open-paris]');
    let trigger: HTMLButtonElement | undefined;
    if (!dialog) return;
    triggers.forEach(button => { button.onclick = () => { trigger = button; dialog.showModal(); }; });
    dialog.onclick = (event) => {
      const rect = dialog.getBoundingClientRect();
      if (event.target === dialog && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) dialog.close();
    };
    dialog.onclose = () => trigger?.focus({ preventScroll: true });
  }
  document.addEventListener('astro:page-load', initParisModal);
  document.addEventListener('astro:before-swap', () => document.querySelector<HTMLDialogElement>('#paris-modal')?.close());
</script>
<style>
  dialog { width: min(420px, calc(100vw - 32px)); max-height: calc(100svh - 32px); overflow-y: auto; margin: auto; padding: var(--space-6); border: 0.5px solid var(--color-border-primary); border-radius: var(--radius-menu); background: var(--color-bg-element); color: var(--color-text-primary); box-shadow: var(--shadow-md); font-size: var(--text-base); font-weight: var(--font-weight-medium); }
  dialog::backdrop { background: rgb(var(--shadow-rgb) / 0.24); backdrop-filter: blur(4px); }
  dialog[open] { animation: paris-arrive 220ms ease-out; }
  .modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-4); }
  .eyebrow { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-tiny); letter-spacing: 0.08em; color: var(--color-text-secondary); }
  .map-badge { display: block; width: 16px; height: 16px; background: var(--color-text-secondary); mask: url('/images/icons/map-pin-fill.svg') center / contain no-repeat; }
  h2 { font-size: var(--text-title); font-weight: var(--font-weight-medium); line-height: 1.2; margin: 0; }
  button { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; background: transparent; border-radius: var(--radius-md); color: var(--color-text-secondary); cursor: pointer; }
  button:hover { background: var(--color-bg-hover); color: var(--color-text-primary); }
  p { margin-top: var(--space-3); color: var(--color-text-secondary); line-height: 1.4; }
  nav { display: flex; flex-direction: column; gap: 0; margin-top: var(--space-6); border-top: 0.5px solid var(--color-border-secondary); }
  a { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4) var(--space-2); border-bottom: 0.5px solid var(--color-border-secondary); border-radius: 0; transition: background 180ms ease, border-color 180ms ease; }
  a:hover { background: var(--color-bg-hover);  }
  .category-icon { width: 40px; height: 40px; flex-shrink: 0; background: var(--color-text-secondary); mask: var(--category-icon) center / 24px no-repeat; }
  .category-copy { display: flex; flex: 1; flex-direction: column; gap: var(--space-1); }
  .category-title { font-size: var(--text-lg); }
  .category-description { color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.3; }
  a :global(svg) { flex-shrink: 0; color: var(--color-text-tertiary); transition: transform 180ms ease, color 180ms ease; }
  a:hover :global(svg) { color: var(--color-text-primary); transform: translate(2px, -2px); }
  .modal-footnote { margin: var(--space-4) 0 0; text-align: center; font-size: var(--text-sm); color: var(--color-text-tertiary); }
  button:focus-visible, a:focus-visible { outline: 2px solid var(--color-text-tertiary); outline-offset: 3px; }
  @keyframes paris-arrive { from { opacity: 0; transform: translateY(8px) scale(0.98); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { dialog[open] { animation: none; } a, a :global(svg) { transition: none; } }
</style>
