---
import RailLink from '../RailLink.astro';
import ContactIcon from '../ContactIcon.astro';
import { links } from '../../data/links';
interface Props { activePage?: 'about' | 'design' | 'photography'; }
const { activePage = 'about' } = Astro.props;
const pages = [{label:'About',href:'/',id:'about',icon:'home'}, {label:'Design',href:'/design',id:'design',icon:'design'}, {label:'Photography',href:'/photography',id:'photography',icon:'photography'}];
const contacts = [{label:'Book a call',icon:'cal',href:links.scheduling.cal},{label:'GitHub',icon:'github',href:links.social.github},{label:'LinkedIn',icon:'linkedin',href:links.social.linkedin}] as const;
---
<aside class="section-header">
  <div class="rail-top">
    <a class="identity" href="/"><img src="/images/icons/profile.webp" alt="" width="36" height="36" /><span>Thomas Cochet<span class="tagline">Designing from Paris</span></span></a>
    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-navigation"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path class="burger-top" d="M4 7h16" /><path class="burger-middle" d="M4 12h16" /><path class="burger-bottom" d="M4 17h16" /></svg></button>
    <div id="mobile-navigation" class="navigation-menu">
    <nav aria-label="Main navigation">{pages.map(page => <RailLink href={page.href} label={page.label} icon={`/images/navigation/${page.icon}.svg`} active={activePage === page.id} />)}</nav>
  <div class="rail-contact">{contacts.map(item => <a class="contact-action" href={item.href} target="_blank" rel="noopener noreferrer"><ContactIcon name={item.icon} />{item.label}</a>)}</div>
    </div>
  </div>
</aside>
<style>
  .section-header { view-transition-name: site-rail; position: fixed; inset: 0 auto 0 0; width: var(--rail-width); height: 100svh; padding: var(--space-4); z-index: var(--layer-header); display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-8); overflow-y: auto; background: var(--color-bg-canvas); font-size: var(--text-base); font-weight: var(--font-weight-medium); line-height: 1.25; }
  .rail-top { display: flex; flex-direction: column; gap: var(--space-5); }
  .identity { display: flex; flex-direction: column; gap: var(--space-3); }
  .identity img { border-radius: var(--radius-md); }
  .tagline { display: block; color: var(--color-text-secondary); margin-top: var(--space-1); }
  nav { display: flex; flex-direction: column; gap: var(--space-1); }
  .rail-contact { display: flex; flex-direction: column; gap: var(--space-4); }
  .rail-contact .contact-action { display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: var(--space-2); width: 100%; min-height: 0; height: auto; margin: 0; padding: 0; border: 0; background: transparent; box-shadow: none; font-family: var(--font-sans); font-size: var(--text-base); font-weight: var(--font-weight-medium); line-height: 1.25; color: var(--color-text-secondary); cursor: pointer; text-align: left; }
  .rail-contact .contact-action:hover, .rail-contact .contact-action:focus-visible { color: var(--color-text-primary); }
  .contact-action:focus-visible { outline: 2px solid var(--color-text-primary); outline-offset: var(--space-1); }
  .contact-action:hover :global(.contact-icon), .contact-action:focus-visible :global(.contact-icon) { --contact-background: var(--brand-background); --contact-foreground: white; }
  .navigation-menu { display: contents; }
  .menu-toggle { display: none; }
  @media (min-width: 901px) { .rail-top { flex: 1; } .rail-contact { margin-top: auto; } }
  @media (max-width: 900px) {
    .section-header { position: sticky; top: 0; width: 100%; height: var(--header-height); min-height: var(--header-height); padding: var(--space-2) var(--space-4); overflow: visible; }
    :global(body:has(.section-header) #canvas-viewport), :global(body:has(.section-header) .design-splash) { top: var(--header-height); }
    .rail-top { flex-direction: row; align-items: center; justify-content: space-between; gap: var(--space-2); }
    .identity { flex-direction: row; align-items: center; gap: var(--space-2); }
    .identity img { width: 24px; height: 24px; }
    .tagline { display: none; }
    .menu-toggle { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; padding: 0; border: 0; border-radius: var(--radius-md); background: transparent; color: var(--color-text-primary); cursor: pointer; }
    .menu-toggle:hover, .menu-toggle[aria-expanded="true"] { background: var(--color-bg-active); }
    .menu-toggle:focus-visible { outline: 2px solid var(--color-text-primary); }
    .navigation-menu { display: block; visibility: hidden; opacity: 0; pointer-events: none; transform: translateY(-6px) scale(0.985); transform-origin: top right; transition: opacity 140ms ease, transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0s 160ms; position: absolute; top: 100%; left: var(--space-2); right: var(--space-2); padding: var(--space-2); background: var(--color-bg-page); border: 0.5px solid var(--color-border-primary); border-radius: var(--radius-md); box-shadow: var(--shadow-md); max-height: calc(100svh - var(--header-height) - var(--space-2)); overflow-y: auto; }
    .section-header.menu-open .navigation-menu { visibility: visible; opacity: 1; pointer-events: auto; transform: translateY(0) scale(1); transition-delay: 0s; transition-duration: 180ms, 220ms, 0s; }
    .rail-contact { display: flex; gap: var(--space-1); margin-top: var(--space-2); padding-top: var(--space-2); border-top: 0.5px solid var(--color-border-secondary); }
    .rail-contact .contact-action:hover, .rail-contact .contact-action:focus-visible, nav :global(.rail-link:hover), nav :global(.rail-link:focus-visible), nav :global(.rail-link[aria-current="page"]) { background: var(--color-bg-hover); color: var(--color-text-primary); }
    .rail-contact .contact-action, nav :global(.rail-link) { min-height: 44px; border-radius: var(--radius-md); padding: var(--space-2); transition: background-color 160ms ease, color 160ms ease; }
    .contact-action:hover :global(.contact-icon), .contact-action:focus-visible :global(.contact-icon) { --contact-background: var(--color-text-primary); }
    .menu-toggle svg path { transform-origin: 12px 12px; transition: transform 220ms ease, opacity 160ms ease; }
    .menu-toggle[aria-expanded="true"] .burger-top { transform: translateY(5px) rotate(45deg); transform-origin: 12px 7px; }
    .menu-toggle[aria-expanded="true"] .burger-middle { opacity: 0; transform: scaleX(0.5); }
    .menu-toggle[aria-expanded="true"] .burger-bottom { transform: translateY(-5px) rotate(-45deg); transform-origin: 12px 17px; }
    @media (prefers-reduced-motion: reduce) { .navigation-menu, .menu-toggle svg path { transition: none; } }
  }
</style>
<script>
  let cleanup: (() => void) | undefined;
  function initMenu() {
    cleanup?.();
    const header = document.querySelector<HTMLElement>('.section-header');
    const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = header?.querySelector<HTMLElement>('.navigation-menu');
    if (!header || !toggle || !menu) return;
    const mobile = window.matchMedia('(max-width: 900px)');
    menu.inert = mobile.matches;
    const controller = new AbortController();
    const options = { signal: controller.signal };
    const setOpen = (open: boolean) => {
      menu.inert = mobile.matches && !open;
      header.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    mobile.addEventListener('change', () => setOpen(false), options);
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'), options);
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a, button')) setOpen(false);
    }, options);
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) setOpen(false);
    }, options);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
    }, options);
    header.addEventListener('focusout', (event) => {
      if (!header.contains(event.relatedTarget as Node)) setOpen(false);
    }, options);
    cleanup = () => controller.abort();
  }
  document.addEventListener('astro:page-load', initMenu);
</script>
