---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chrome from '../components/canvas/Chrome.astro';
import WorkAccordion from '../components/WorkAccordion.astro';
import Icon from '../components/Icon.astro';
import YouTubeModal from '../components/YouTubeModal.astro';
import { links } from '../data/links';
import { getCollection } from 'astro:content';

const milestones = await getCollection('milestones');
const sortedMilestones = milestones.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Extract a YouTube video id (+ optional start time) from a watch/short URL so
// those highlights open in the in-page player instead of navigating away.
function parseYouTube(url: string): { id: string; start: number } | null {
  let u: URL;
  try { u = new URL(url); } catch { return null; }
  const host = u.hostname.replace(/^www\./, '');
  let id = '';
  if (host === 'youtu.be') id = u.pathname.slice(1);
  else if (host === 'youtube.com' || host === 'm.youtube.com') id = u.searchParams.get('v') ?? '';
  if (!/^[\w-]{11}$/.test(id)) return null;
  const t = u.searchParams.get('t') ?? u.searchParams.get('start') ?? '';
  const start = parseInt(t, 10) || 0; // handles "3016" and "3016s"
  return { id, start };
}
---

<BaseLayout title="Thomas Cochet — Product Designer" description="Product Designer based in Paris, France.">


  <script>
    function settleIntro() {
      try { sessionStorage.setItem('aboutIntroSeen', '1'); } catch {}
      // Clear the gating class once the last animation has finished.
      // Last delay = 1280ms, duration = 900ms → ~2.2s.
      window.setTimeout(() => {
        document.documentElement.classList.remove('intro-active');
      }, 2300);
    }
    document.addEventListener('astro:page-load', settleIntro);
  </script>

  <style>
    body { overflow-y: auto; overflow-x: hidden; }

  .bio-link { display: inline; white-space: nowrap; text-decoration: underline; text-decoration-color: var(--color-border-primary); text-underline-offset: 3px; }
  .bio-link img { display: inline-block; width: 16px; height: 16px; vertical-align: -2px; margin-right: var(--space-1); border-radius: var(--radius-sm); }
  .bio-link:hover { text-decoration-color: var(--color-text-primary); }
  .bio-link:focus-visible { outline: 2px solid var(--color-text-primary); outline-offset: 3px; border-radius: var(--radius-sm); }
    .intro-portrait { width: 200px; height: 143px; object-fit: cover; border-radius: var(--radius-md); }
    .about-main {
      max-width: 608px;
      margin: 0 auto;
      padding: var(--space-16);
      display: flex;
      flex-direction: column;
      gap: var(--space-12);
    }

    /* Portrait and introduction. */
    .about-intro {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    @media (max-width: 768px) {
      .about-main { padding: var(--space-20) var(--space-6) var(--space-10); }
    }

    /* ─── Sections ─── */

    .about-section {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }


    /* ─── About text ─── */

    .about-text {
      font-family: var(--font-sans);
      font-size: var(--text-lg);
      font-weight: var(--font-weight-medium);
      line-height: 1.25;
      color: var(--color-text-primary);
      margin: 0;
    }

    /* ─── Divider ─── */

    /* ─── Experience table ─── */

    .experience-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      padding-bottom: var(--space-3);
      border-bottom: 1px solid var(--color-border-secondary);
    }

    .experience-heading {
      font-family: var(--font-sans);
      font-size: var(--text-base);
      font-weight: var(--font-weight-medium);
      line-height: 1.25;
      color: var(--color-text-secondary);
      margin: 0;
    }




    .experience-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }





    /* ─── Highlights ─── */

    .achievements-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
    }

    .achievement-card {
      display: block;
      padding: var(--space-4);
      margin: 0 -16px;
      border-radius: var(--radius-lg);
      color: inherit;
      text-decoration: none;
      transition: background 0.2s ease;
    }

    .achievement-card--link:hover {
      background: var(--color-bg-hover);
      cursor: pointer;
    }

    .achievement-body {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }

    .achievement-cover {
      width: 100%;
      max-width: 120px;
      height: auto;
      border-radius: var(--radius-md);
      margin-bottom: var(--space-3);
      display: block;
    }

    .achievement-title {
      font-family: var(--font-sans);
      font-size: var(--text-base);
      font-weight: var(--font-weight-medium);
      line-height: 1.3;
      color: var(--color-text-primary);
      margin: 0;
    }

    .achievement-title-tail {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      white-space: nowrap;
    }

    /* :global() so the color reaches the SVG rendered by the Icon component,
       which lives in its own style scope and doesn't carry this file's cid. */
    .achievement-title :global(.achievement-arrow) {
      flex-shrink: 0;
      color: var(--color-text-tertiary);
      transition: color 0.15s ease;
    }

    .achievement-card--link:hover :global(.achievement-arrow) {
      color: var(--color-text-primary);
    }

    .achievement-description {
      font-family: var(--font-sans);
      font-size: var(--text-base);
      font-weight: var(--font-weight-medium);
      line-height: 1.4;
      color: var(--color-text-secondary);
      margin: 0;
    }

    /* ─── Mobile overrides (placed after base rules so they win on source-order) ─── */

    /* ─── Intro animation ─── */

    @keyframes about-fade-up {
      from { opacity: 0; transform: translateY(10px); filter: blur(10px); }
      to   { opacity: 1; transform: translateY(0);    filter: blur(0); }
    }

    html.intro-active .about-text,
    html.intro-active .about-experience,
    html.intro-active .about-achievements {
      animation: about-fade-up 900ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
      /* Let Safari mobile paint each intro element independently. */
      will-change: transform, opacity, filter;
    }


    html.intro-active .about-text:nth-of-type(1) { animation-delay:  520ms; }
    html.intro-active .about-text:nth-of-type(2) { animation-delay:  700ms; }

    html.intro-active .about-experience   { animation-delay: 880ms; }
    html.intro-active .about-achievements { animation-delay: 1060ms; }

    @media (prefers-reduced-motion: reduce) {
      html.intro-active .about-text,
      html.intro-active .about-experience,
      html.intro-active .about-achievements {
        animation: none;
      }
    }
  </style>

  <Chrome activePage="about" />
  <div class="content-panel">
  <main class="about-main">
    <div class="about-intro">
      <img class="intro-portrait" src="/images/intro-portrait.png" alt="Thomas working on his laptop" width="200" height="143" />
      <div class="about-section">
        <p class="about-text">Currently leading product and design at <a class="bio-link" href={links.work.hyperline} target="_blank" rel="noopener noreferrer"><img src="/images/icons/hyperline.svg" alt="" width="16" height="16" />Hyperline</a>, building cool side projects like <a class="bio-link" href={links.work.recccords} target="_blank" rel="noopener noreferrer"><img src="/images/icons/recccords.svg" alt="" width="16" height="16" />Recccords</a>.</p>
        <p class="about-text">I design products with a business mindset, working as an early stage operator at the intersection of product, brand, frontend and strategy.</p>
        <p class="about-text">I'm a multi-disciplinary creative, crafting brand identities, building products, designing websites, and capturing stories through photography.</p>
      </div>
    </div>

    <!-- Experience -->
    <div class="about-section about-experience">
      <div class="experience-header">
        <p class="experience-heading">Work</p>
      </div>
      <ul class="experience-list">
      <WorkAccordion collapsible={false} title="Hyperline" href={links.work.hyperline} date="2022 - Now" icon="/images/icons/hyperline.svg" image="/images/projects/hyperline/main.webp"
            description="Hyperline is the modern billing & revenue management platform built for SaaS companies."
            links={[
              { href: '/design#hyperline', label: 'See the work' },
              { href: links.work.hyperline, label: 'Visit website' },
            ]} />
      <WorkAccordion collapsible={false} title="Shine" href={links.work.shine} date="2021 - 2022" icon="/images/icons/shine.png" image="/images/projects/shine/shine-cover.webp"
            description="I designed the onboarding flow, the partner marketplace and contributed to the design system, working end-to-end with PMs and engineers."
            links={[{ href: links.work.shine, label: 'Visit website' }]} />
      <WorkAccordion collapsible={false} title="Freelance" date="2020 - 2021" icon="/images/icons/freelance.png" image="/images/projects/misc/subagents.webp"
            description="Freelance design work across branding, websites, and product, with assorted clients between full-time roles."
            links={[{ href: '/design#misc', label: 'See the work' }]} />
      <WorkAccordion collapsible={false} title="BNP Paribas" date="2018 - 2019" icon="/images/icons/bnp-paribas.png" image="/images/projects/misc/bnp-paribas.webp"
            description="Worked as Project Manager to improve customer satisfaction, across all canals. Last corporate experience before shifting to design." />
      <WorkAccordion collapsible={false} title="TeamSup" date="2017" icon="/images/icons/teamsup.png" image="/images/projects/misc/teamsup.webp"
            description="E-learning platform for competitive business school exams, where I led marketing and platform design. Acquired in 2017." />
      <WorkAccordion collapsible={false} title="British Airways" date="2016" icon="/images/icons/british-airways.png" image="/images/projects/misc/british-airways.webp"
            description="Summer internship at OpenSkies, British Airways' New York to Paris subsidiary, working on social media, PR, and brand partnerships." />
      </ul>
    </div>

    <!-- Highlights -->
    <section class="about-section about-achievements">
      <div class="experience-header">
        <p class="experience-heading">Highlights</p>
      </div>
      <ol class="achievements-list">
        {sortedMilestones.map((milestone) => {
          const Tag = milestone.data.externalUrl ? 'a' : 'div';
          const yt = milestone.data.externalUrl ? parseYouTube(milestone.data.externalUrl) : null;
          const linkProps = milestone.data.externalUrl
            ? {
                href: milestone.data.externalUrl,
                target: '_blank',
                rel: 'noopener noreferrer',
                // YouTube links open the in-page player; the href above is the
                // no-JS fallback (opens the video on YouTube in a new tab).
                ...(yt ? { 'data-youtube-id': yt.id, 'data-youtube-start': String(yt.start) } : {}),
              }
            : {};
          // Split the title so the last word + arrow can stay glued together
          // via `white-space: nowrap` — prevents an orphaned arrow on its own line.
          const lastSpace = milestone.data.title.lastIndexOf(' ');
          const titleHead = lastSpace >= 0 ? milestone.data.title.slice(0, lastSpace + 1) : '';
          const titleTail = lastSpace >= 0 ? milestone.data.title.slice(lastSpace + 1) : milestone.data.title;
          return (
            <li class="achievement-row">
              <Tag {...linkProps} class:list={["achievement-card", milestone.data.externalUrl && "achievement-card--link"]}>
                <div class="achievement-body">
                  {milestone.data.cover && (
                    <img src={milestone.data.cover} alt={milestone.data.title} class="achievement-cover" loading="lazy" decoding="async" />
                  )}
                  <h3 class="achievement-title">
                    {milestone.data.externalUrl ? (
                      <>
                        {titleHead}<span class="achievement-title-tail">{titleTail}<Icon name={yt ? 'arrows-out' : 'arrow-up-right'} size={16} class="achievement-arrow" /></span>
                      </>
                    ) : milestone.data.title}
                  </h3>
                  <p class="achievement-description">{milestone.data.description}</p>
                </div>
              </Tag>
            </li>
          );
        })}
      </ol>
    </section>
  </main>

  <YouTubeModal />
  </div>
</BaseLayout>
