---
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Image URLs to preload via `<link rel="preload">`. Use for hero/above-fold
      images that must paint immediately (e.g. the design splash preview). */
  preloadImages?: string[];
}

const {
  title = 'Thomas Cochet — Product Designer',
  description = 'Product Designer based in Paris, France.',
  preloadImages = [],
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="noon" style="color-scheme: light;">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="light" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/images/projects/misc/opengraph.jpg', Astro.site ?? 'https://thomascochet.com').toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/images/projects/misc/opengraph.jpg', Astro.site ?? 'https://thomascochet.com').toString()} />

    <link rel="icon" type="image/webp" href="/images/icons/profile.webp" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/PPNeueMontreal-Book.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/PPNeueMontreal-Medium.woff2" crossorigin />
    {preloadImages.map((href) => (
      <link rel="preload" as="image" href={href} />
    ))}
    <title>{title}</title>

    {/* Apply intro gating before first paint and across view-transition swaps. */}
    <script is:inline>
      (function () {
        // Hold the initial paint until the actual typeface is available. The
        // timeout keeps failed or very slow assets from blocking the page.
        var html = document.documentElement;
        html.classList.add('fonts-loading');
        var released = false;
        function releaseFirstPaint() {
          if (released) return;
          released = true;
          clearTimeout(fallbackTimer);
          html.classList.remove('fonts-loading');
        }
        var fallbackTimer = setTimeout(releaseFirstPaint, 1800);
        document.addEventListener('DOMContentLoaded', function () {
          var fonts = Promise.all([
            document.fonts.load('400 16px "PP Neue Montreal"'),
            document.fonts.load('500 16px "PP Neue Montreal"'),
          ]);
          var portrait = document.querySelector('.intro-portrait');
          var image = portrait && portrait.decode ? portrait.decode() : Promise.resolve();
          Promise.allSettled([fonts, image]).then(releaseFirstPaint);
        }, { once: true });

        // Play the About entrance on direct loads, then keep in-site navigation
        // immediate. Animation time stays paused until the first paint is ready.
        function applyIntroGating(htmlEl, pathname, hash) {
          // The Design landing page remains available on every unlinked visit.
          htmlEl.classList.toggle('design-splash-active', pathname.replace(/\/$/, '') === '/design' && !hash);
          htmlEl.classList.toggle('intro-active', pathname === '/');
        }

        applyIntroGating(document.documentElement, window.location.pathname, window.location.hash);

        document.addEventListener('astro:before-swap', function (e) {
          var toUrl = e.to ? new URL(e.to, window.location.origin) : window.location;
          applyIntroGating(e.newDocument.documentElement, toUrl.pathname, toUrl.hash);
          // Skip first-visit reveals during an in-site navigation.
          releaseFirstPaint();
          e.newDocument.documentElement.classList.remove('fonts-loading', 'intro-active', 'design-intro-active');
        });



        // Mobile + /design: force a full page reload instead of using view
        // transitions. View transitions don't fully release the previous
        // /design's DOM, decoded image bitmaps, and panzoom GPU layer before
        // the new /design DOM mounts, so the second visit pushes iOS Safari
        // over its per-tab memory ceiling and triggers the "can't open this
        // page" kill. A real navigation gives the new visit a clean memory
        // slate. Initial page loads aren't affected (no view transition).
        document.addEventListener('astro:before-preparation', function (e) {
          if (!window.matchMedia('(max-width: 768px)').matches) return;
          if (!e.to) return;
          var toUrl = new URL(e.to, window.location.origin);
          if (toUrl.pathname.startsWith('/design')) {
            e.preventDefault();
            window.location.assign(toUrl.toString());
          }
        });
      })();
    </script>

    <script>
      let photographyScroll = { panel: 0, window: 0 };

      function revealDecodedMedia(root: ParentNode = document) {
        const images = root.querySelectorAll<HTMLImageElement>('img[data-media-reveal]');

        images.forEach((image) => {
          if (image.dataset.mediaReady === 'true') return;

          const reveal = () => {
            image.dataset.mediaReady = 'true';
          };

          const decodeAndReveal = () => {
            if (typeof image.decode === 'function') {
              image.decode().catch(() => {}).finally(reveal);
            } else {
              reveal();
            }
          };

          if (image.complete) {
            decodeAndReveal();
          } else {
            image.addEventListener('load', decodeAndReveal, { once: true });
            image.addEventListener('error', reveal, { once: true });
          }
        });
      }

      document.documentElement.classList.add('media-reveal-enabled');
      revealDecodedMedia();

      document.addEventListener('astro:before-preparation', () => {
        if (location.pathname.replace(/\/$/, '') === '/photography') {
          photographyScroll = { panel: document.querySelector('.content-panel')?.scrollTop ?? 0, window: window.scrollY };
        }
      });
      document.addEventListener('astro:page-load', () => {
        revealDecodedMedia();
        if (location.pathname.replace(/\/$/, '') !== '/photography') return;
        const panel = document.querySelector('.content-panel');
        if (panel) panel.scrollTop = photographyScroll.panel;
        window.scrollTo(0, photographyScroll.window);
      });
    </script>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
